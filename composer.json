{
    "name": "simplysmart/simplo",
    "type": "project",
    "description": "The cli application for the simplySMART framework",
    "keywords": ["simplySMART", "simplo", "cli"],
    "license": "mit",
    "require": {
        "php": "^8.3",
        "doctrine/dbal": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Simplysmart\\Simplo\\": "src/",
            "Simplysmart\\Simplo\\App\\": "src/app/"
        },
        "files": [

        ]
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simplysmart\\Simplo\\App\\Providers\\SimploProvider"
            ],
            "aliases":
                {
                    "Simplo": "Simplysmart\\Simplo\\Simplo"
                }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
