{
    "name": "simplysmart/simplo",
    "type": "project",
    "description": "The cli application for the simplySMART framework",
    "keywords": ["simplySMART", "simplo", "cli"],
    "license": "MIT",
    "authors": [
        {
            "name": "Marcin Ulezalka",
            "email": "simplo@simplysmart.pl"
        }
    ],
    "require": {
        "php": "^8.3",
        "doctrine/dbal": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Simplysmart\\Simplo\\": "src/",
            "Simplysmart\\Simplo\\App\\": "src/app/"
        },
        "files": [

        ]
    },
    "scripts": {
        "test": "pest",
        "post-install-cmd": [
            "@php vendor/simplysmart/simplo/simplo publish:launcher",
            "@chmod +755 simplo"
        ],
        "post-update-cmd": [
            "@php vendor/simplysmart/simplo/simplo publish:launcher",
            "@chmod +755 simplo"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simplysmart\\Simplo\\App\\Providers\\SimploProvider"
            ],
            "aliases":
                {
                    "Simplo": "simplo"
                }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
