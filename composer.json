{
    "name": "simplysmart/simplo",
    "type": "project",
    "description": "The cli application for the simplySMART framework",
    "keywords": ["simplySMART", "framework", "simplo", "cli"],
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Simplysmart\\Simplo\\": "src/"
        },
        "files": [

        ]
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simplysmart\\Simplo\\App\\Providers\\SimploProvider"
            ],
            "aliases": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
