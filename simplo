#!/usr/bin/env php
<?php

require __DIR__.'/vendor/autoload.php';

use Illuminate\Contracts\Filesystem\FileNotFoundException;
use Illuminate\Filesystem\Filesystem;
use Illuminate\Support\Str;

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'clear:env':
        clearEnvAll();
        break;
    case 'copy:vendor':
        copyVendor();
        break;
    case 'example':
        showManualLibsExample();
        break;
    case 'install':
        if (empty($argv[2])) {
            echo "Usage: php simplo install [ModuleName]\n";
            exit(1);
        }else{
            echo "Checkin: php simplo install [ModuleName]\n";
        }
        try {
            installModule($argv[2]);
        } catch (FileNotFoundException $e) {
            echo "Failed: php simplo install [ModuleName]\n";
        }
        break;
    case 'make:theme-config':
        makeThemeConfig($argv[2] ?? null);
        break;
    case 'publish':
        publish();
        break;
    case 'publish:vendor':
        publishVendor();
        break;
    case 'theme:publish':
        if (($argv[2] ?? '') === '-all') {
            publishAllThemes();
        } elseif (!empty($argv[2]) && !empty($argv[3])) {
            publishSingleTheme($argv[2], $argv[3]);
        } else {
            echo "Usage:\n";
            echo "  theme:publish -all\n";
            echo "  theme:publish [theme] [system]\n";
        }
        break;
    case 'update':
        simploUpdate();
        break;
    case 'help':
    default:
        showHelp();
        break;
}

