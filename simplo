/**
 * Installs a development module by copying and customizing a template structure.
 *
 * This function performs the following steps:
 * - Copies the entire `.templates/` directory into `dev_modules/{moduleName}`.
 * - Creates an empty README file for the module.
 * - Replaces placeholders inside all files in the new module directory with names based on $moduleName.
 * - Renames files and directories in the module directory to match $moduleName conventions.
 * - Generates a composer.json file tailored for the module.
 * - Generates a default route file inside `src/routes/` for the module.
 * - Copies `.gitignore` file from the templates if it exists.
 * - Attempts to run an installer class specific to the module if present.
 *
 * @param string $moduleName The name of the module to install.
 *
 * @throws Illuminate\Contracts\Filesystem\FileNotFoundException When placeholder replacement fails due to missing files.
 * @return void
 */
function installModule(string $moduleName): void
{
    $basePath   = __DIR__;
    $fs         = new Illuminate\Filesystem\Filesystem();

    $templateSource  = "$basePath/dev_modules/.templates";
    $destinationRoot = "$basePath/dev_modules/$moduleName";

    if (!$fs->isDirectory($templateSource)) {
        echo "❌ Templates not found in $templateSource\n";
        return;
    }

    if ($fs->isDirectory($destinationRoot)) {
        echo "⚠️ Module already exists: $moduleName\n";
        return;
    }

    $fs->copyDirectory($templateSource, $destinationRoot);
    echo "✅ Full template structure copied to $destinationRoot\n";

    createEmptyReadme($moduleName);

    try {
        // Tu podmieniamy placeholdery w zawartości plików
        replaceInFileContents($destinationRoot, $moduleName);
    } catch (FileNotFoundException $e) {
        echo "❌ Placeholder replacement failed: {$e->getMessage()}\n";
        return;
    }

    // Zmieniamy nazwy plików i katalogów
    renameFilesAndDirs($destinationRoot, $moduleName);

    generateFullComposerForModule($moduleName);
    //generateRouteFile($moduleName, $basePath, $fs);

    $gitignore = "$templateSource/.gitignore";
    if ($fs->exists($gitignore)) {
        $fs->copy($gitignore, "$destinationRoot/.gitignore");
        echo "📄 Copied .gitignore to module root\n";
    }

    $installerClass = "DevModules\\$moduleName\\App\\Installers\\{$moduleName}Installer";
    if (class_exists($installerClass)) {
        (new $installerClass())->install();
        echo "⚙️ Installer $installerClass executed.\n";
    } else {
        echo "🔍 No installer class found for $moduleName. Skipped.\n";
    }
}


